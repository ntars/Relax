{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relax.local/contracts/backup-manifest.schema.json",
  "title": "BackupManifest",
  "type": "object",
  "required": ["manifestVersion", "contractVersion", "schemaVersion", "serverVersion", "createdAt", "db", "files", "config", "report"],
  "properties": {
    "manifestVersion": { "type": "integer", "const": 1 },
    "contractVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "serverVersion": { "type": "string" },
    "createdAt": { "type": "string", "format": "date-time" },
    "db": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relPath", "sha256", "bytes"],
        "properties": {
          "relPath": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["redacted", "keys"],
      "properties": {
        "redacted": { "type": "boolean", "const": true },
        "keys": { "type": "array", "items": { "type": "string" } }
      }
    },
    "report": {
      "type": "object",
      "required": ["ok", "complete", "degraded"],
      "properties": {
        "ok": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "degraded": { "type": "array", "items": { "type": "object" } }
      }
    }
  },
  "additionalProperties": false
}
