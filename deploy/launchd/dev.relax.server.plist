<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.relax.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/relax/app/relax</string>
    <string>serve</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/relax</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/relax/logs/relax.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/relax/logs/relax.err.log</string>
</dict>
</plist>
