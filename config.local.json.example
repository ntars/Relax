{
  "_comment": "复制为 config.local.json 后填写；含 secret 的文件权限必须 0600，且不得入库。secret 留空表示由 relax 首次启动时生成。",
  "listen": {
    "host": "127.0.0.1",
    "port": 3000
  },
  "dataDir": "data",
  "tunnelMode": "none",
  "feedAllowlist": [
    "https://example.com/feed.xml"
  ],
  "backup": {
    "localDir": "data/backups/local",
    "offsiteDir": "data/backups/offsite",
    "dailyHour": 3
  },
  "secret": ""
}
