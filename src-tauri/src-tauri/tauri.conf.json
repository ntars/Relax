{
  "$schema": "https://schema.tauri.app/tauri.conf.2.1.json",
  "productName": "Relax",
  "version": "0.1.0",
  "identifier": "com.relax.family",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "bundle": {
    "active": true,
    "targets": ["apk", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "window_state": {
      "active": true
    }
  },
  "updater": {
    "active": false
  }
}
